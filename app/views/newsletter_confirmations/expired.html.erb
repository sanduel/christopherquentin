<% content_for :title, "Link Expired — Christopher Quentin" %>

<section class="max-w-[760px] mx-auto px-6 lg:px-10 pt-20 pb-24">
  <div class="flex items-center gap-3">
    <span class="inline-block w-[34px] h-px bg-accent"></span>
    <span class="font-mono text-[12px] tracking-[0.2em] uppercase text-accent">Updates</span>
  </div>

  <h1 class="font-serif font-medium tracking-[-0.02em] text-ink mt-6 mb-0"
      style="font-size: clamp(40px, 5.5vw, 64px); line-height: 1.0;">
    This link has expired.
  </h1>

  <p class="text-[16px] text-muted mt-5 max-w-[560px]">
    Confirmation links work once and expire after 14 days. Sign up again with the form at the bottom of any page and we'll send a new one.
  </p>
</section>
